{
  "name": "opalite",
  "productName": "Opalite",
  "version": "0.1.0",
  "description": "Notas em Markdown, documentos, planilhas e apresentações, guardados numa pasta sua.",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand:icons": "electron scripts/brand-icons.cjs",
    "desktop:shortcuts": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-shortcuts.ps1",
    "package:win": "npm run build && node scripts/package-win.cjs",
    "package:linux": "npm run build && node scripts/package-linux.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "chokidar": "^4.0.3",
    "d3-force": "^3.0.1",
    "docx": "^9.15.3",
    "fflate": "^0.8.3",
    "katex": "^0.16.47",
    "lucide-react": "^1.72.0",
    "mammoth": "^1.13.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^38.8.6",
    "electron-vite": "^4.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
